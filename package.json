{
  "name": "atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Un atlas personal de viajes con privacidad desde el origen",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "scripts": {
    "dev": "npm run dev --workspace @atlas/web -- --host 0.0.0.0",
    "build": "npm run typecheck && npm run build --workspace @atlas/web && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "measure:runtime": "node scripts/measure-runtime.mjs",
    "preview": "npm run preview --workspace @atlas/web -- --host 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:privacy": "tsx scripts/check-privacy.ts",
    "check": "npm run check:privacy && npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
